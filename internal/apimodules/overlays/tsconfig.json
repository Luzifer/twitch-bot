{
  "compilerOptions": {
    "lib": [
      "DOM",
      "ES2020"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "types": [
      "node"
    ]
  },
  "include": [
    "build.ts",
    "src/**/*.ts",
    "src/**/*.vue"
  ]
}